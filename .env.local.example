# All optional. Code defaults: projectId xvyxwo8y, dataset production (public dataset, tokenless reads).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: slug rendered on "/" (unset = neutral sample). Only with the practice's consent.
NEXT_PUBLIC_ROOT_CLINIC_SLUG=
# Only needed for draft mode (viewing unpublished drafts). Viewer token is enough.
SANITY_API_TOKEN=
# Enables /api/draft?secret=...&path=/<slug>. If unset, the route refuses.
SANITY_PREVIEW_SECRET=
NEXT_PUBLIC_SANITY_STUDIO_PREVIEW_URL=
NEXT_PUBLIC_SANITY_VISUAL_EDITING=false
